"<!doctype html>\n<html lang=\"tr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Token İhtiyacı Simülatörü · Cogniti</title>\n<style>\n@font-face {\n  font-family: Nunito;\n  font-style: normal;\n  font-weight: 400 700;\n  font-display: swap;\n  src: url(\"data:font/woff2;base64,\") format(\"woff2\");\n  unicode-range: U+100-2BA, U+2BD-2C5, U+2C7-2CC, U+2CE-2D7, U+2DD-2FF, U+304, U+308, U+329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n:root{font-family:Nunito,Arial,sans-serif;color:#203958;background:#f6f9fc;font-size:16px;--blue:#247dce;--muted:#6f7c90;--line:#d9e5f1;--pale:#edf5fd}*{box-sizing:border-box}body{margin:0}button,input{font:inherit;color:inherit}header{background:white;border-bottom:1px solid var(--line)}.top,main{max-width:1240px;margin:auto;padding:24px 32px}.top{display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{width:180px;height:auto}.eyebrow{font-size:12px;letter-spacing:2px;color:var(--blue);font-weight:600}main{padding-top:34px;padding-bottom:45px}h1{font-size:30px;margin:10px 0}h2{font-size:20px;margin:0}h3{font-size:15px;margin:0 0 16px;font-weight:600}p{margin:0}.intro{color:var(--muted);line-height:1.6;margin:0 0 26px}.card{background:white;border:1px solid var(--line);border-radius:16px;padding:24px;box-shadow:0 3px 12px #20395804}.heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:22px}.heading small{color:var(--muted)}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 24px}.field{display:flex;flex-direction:column;gap:7px;min-width:0}.field>span{font-size:14px}.input{border:1px solid var(--line);border-radius:9px;background:white;display:flex;align-items:center;min-width:0}.input:focus-within{outline:2px solid var(--blue);outline-offset:2px}.input input{width:100%;min-width:0;background:transparent;border:0;outline:0;padding:10px 12px;font-size:12.75px;font-variant-numeric:tabular-nums}.input small{padding-right:12px;color:var(--muted);white-space:nowrap;font-size:9px}input[aria-invalid=\"true\"]{color:#ac3726}.group{margin-top:24px;padding-top:22px;border-top:1px solid var(--line)}.subnote{font-size:12px;color:var(--muted);line-height:1.6;margin-top:10px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0}button{background:white;border:1px solid var(--line);border-radius:9px;padding:11px 16px;cursor:pointer;font-size:14px;font-weight:600}button:hover{background:var(--pale)}button:focus-visible{outline:2px solid var(--blue);outline-offset:3px}.primary{background:var(--blue);color:white;border-color:var(--blue)}.primary:hover{background:#1c6eb9}.results{margin-top:0;align-items:start;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.module{min-width:0}.module .heading{margin-bottom:14px}.switch{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer;white-space:nowrap}.switch input{appearance:none;width:38px;height:22px;margin:0;border-radius:12px;background:#c5ced9;position:relative;cursor:pointer}.switch input:checked{background:var(--blue)}.switch input:before{content:'';position:absolute;background:white;width:16px;height:16px;border-radius:50%;top:3px;left:3px;transition:transform .15s}.switch input:checked:before{transform:translateX(16px)}.switch input:focus-visible{outline:2px solid var(--blue);outline-offset:3px}.state{font-size:12px;color:var(--muted);margin-bottom:12px}.module[data-active=\"true\"]{border-top:3px solid var(--blue);padding-top:22px}.rows{display:flex;flex-direction:column;gap:10px}.row{display:flex;justify-content:space-between;gap:16px;font-size:14px}.row span{color:var(--muted)}.row strong{font-weight:600;font-variant-numeric:tabular-nums;text-align:right;overflow-wrap:anywhere}.module-total{display:flex;justify-content:space-between;align-items:baseline;gap:16px;border-top:1px solid var(--line);margin-top:16px;padding-top:16px}.module-total span{font-size:14px;font-weight:700}.module-total strong{font-size:25px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}.module-total small{font-size:13px;color:var(--muted);font-weight:700}.detail{font-size:12px;color:var(--muted);line-height:1.6;margin-top:14px}.total{margin-top:24px;background:#f3f8fe;box-shadow:0 6px 20px #2039580d}.total-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:20px}.total-label{font-size:14px;color:var(--muted)}.number{font-size:38px;color:var(--blue);font-weight:600;font-variant-numeric:tabular-nums;margin-top:5px}.number small{font-size:15px;font-weight:400}.total-note{font-size:13px;line-height:1.6;margin-top:18px}.error{color:#ac3726}.footer{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-top:24px;font-size:12px;color:var(--muted)}.footer button{font-size:12px;font-weight:400}.scope{margin-top:20px;font-size:12px;color:var(--muted);line-height:1.7}@media(max-width:850px){.fields{grid-template-columns:repeat(2,minmax(0,1fr))}.results{grid-template-columns:1fr}.top,main{padding-left:24px;padding-right:24px}}@media(max-width:500px){.fields{grid-template-columns:1fr}.total-grid{grid-template-columns:1fr}.top,main{padding-left:16px;padding-right:16px}.card{padding:20px}.module[data-active=\"true\"]{padding-top:18px}.top .eyebrow{font-size:10px}.logo{width:145px}h1{font-size:25px}.heading{align-items:flex-start}.actions button{flex:1 1 45%}.footer{flex-direction:column;align-items:flex-start}.number{font-size:32px}}@media(prefers-reduced-motion:reduce){.switch input:before{transition:none}}\n.planning-row{display:flex;align-items:end;gap:18px;flex-wrap:wrap}.planning-row .field{max-width:260px;flex:1 1 180px}.planning-row button{min-height:44px}.module-inputs{padding:4px 0 22px;margin-bottom:18px;border-bottom:1px solid var(--line)}.module-inputs button{margin-top:18px}.module .field>span{min-height:40px;display:flex;align-items:end}@media(max-width:500px){.module .field>span{min-height:0}.planning-row .field{max-width:none}.planning-row button{width:100%}}\n\n#card-t .fields,#card-c .fields,#card-e .fields,#card-m .fields{grid-template-columns:1fr;gap:12px}\n#card-t .field,#card-c .field,#card-e .field,#card-m .field{display:grid;grid-template-columns:minmax(0,1fr) 120px;align-items:center;gap:16px;min-height:56px}\n#card-t .field>span,#card-c .field>span,#card-e .field>span,#card-m .field>span{min-height:0;display:block;font-size:15px;line-height:1.5}\n#card-t .heading,#card-c .heading,#card-e .heading,#card-m .heading{margin-bottom:20px}\n#card-t .module-inputs,#card-c .module-inputs,#card-e .module-inputs,#card-m .module-inputs{padding:0;margin-bottom:20px;border:0}\n#card-t .subnote,#card-c .subnote,#card-e .subnote,#card-m .subnote{margin-top:14px}\n#card-t .module-inputs button,#card-c .module-inputs button,#card-e .module-inputs button,#card-m .module-inputs button{margin-top:18px}\n#card-t .rows,#card-c .rows,#card-e .rows,#card-m .rows{gap:12px}\n#card-t .module-total,#card-c .module-total,#card-e .module-total,#card-m .module-total{margin-top:18px;padding-top:0;border:0}\n@media(max-width:500px){#card-t .field,#card-c .field,#card-e .field,#card-m .field{grid-template-columns:1fr;gap:8px;min-height:0}#card-t .fields,#card-c .fields,#card-e .fields,#card-m .fields{gap:18px}#card-t .input,#card-c .input,#card-e .input,#card-m .input{max-width:180px}}\n\n/* Sonuç kartı: üç satır ve ortak iki sütun ekseni. */\n.total-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;margin-top:0;--sonuc-aralik:24px}\n.total-grid>.need-summary{grid-column:1;display:grid;grid-template-columns:minmax(0,1fr) max-content minmax(0,1fr);justify-self:stretch;min-width:0;text-align:left}\n.need-summary>.total-label{grid-column:2;width:0;white-space:nowrap;font-size:14px;color:var(--muted)}\n.need-summary>.number{grid-column:2;margin-top:5px;font-size:38px;font-weight:600;line-height:1.3}\n.purchase-summary{grid-column:1;min-width:0;width:100%;border-top:1px solid var(--line);padding-top:16px}\n.suggestions-grid,.recommendation{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--sonuc-aralik);align-items:stretch}\n.suggestions-grid::before,.recommendation::after{content:\"\";position:absolute;left:50%;transform:translateX(-50%);width:2px;background:var(--line);pointer-events:none}\n.suggestions-grid::before{top:8px;bottom:8px}\n.suggestions-grid>div{display:grid;grid-template-columns:minmax(0,1fr) 110px;grid-template-rows:auto;column-gap:8px;align-content:start;min-width:0;width:100%;text-align:left}.offer-content{grid-column:1;grid-row:1;display:grid;grid-template-columns:minmax(0,1fr);justify-self:center;align-content:start;min-width:0;width:max-content;max-width:100%;row-gap:4px}\n.suggestions-grid .total-label,.suggestions-grid .number,.suggestions-grid .package-pricing{justify-self:stretch;text-align:left;margin:0;padding:0;min-width:0}\n.suggestions-grid .total-label{font-size:11.2px;color:var(--muted)}\n.suggestions-grid .number{font-size:30.4px;font-weight:600;line-height:1.3;font-variant-numeric:tabular-nums}\n.suggestions-grid .number small{font-size:12px;font-weight:400}\n.package-pricing{line-height:1.5;overflow-wrap:anywhere}\n.package-price{font-size:11.2px;font-weight:400;color:var(--muted)}\n.package-terms{font-size:8.8px;font-weight:400;color:var(--muted)}\n.price-separator{color:var(--muted)}\n.package-pricing:has(.package-price:empty) .price-separator{display:none}\n.pricing-link{position:static;grid-column:2;grid-row:1;justify-self:end;align-self:end;display:inline-flex;align-items:center;gap:5px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:var(--blue);font-size:8.8px;line-height:16.8px;font-weight:400;white-space:nowrap}\n.pricing-link svg{width:11.2px;height:11.2px}\n.pricing-link:hover{background:transparent;text-decoration:underline}\n.recommendation{grid-column:1;width:100%;min-width:0;border-top:1px solid var(--line);padding-top:20px;text-align:left}\n.recommendation::after{top:28px;bottom:8px}\n.summary-column{display:grid;grid-template-rows:1fr auto;min-width:0}\n.club-summaries{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;min-width:0;width:100%;margin:0;border-bottom:1px solid var(--line);padding-bottom:12px;align-items:start}\n.club-summary{position:relative;display:grid;grid-template-columns:minmax(0,1fr);align-content:start;min-width:0;text-align:left}\n.club-summary+.club-summary::before{content:\"\";position:absolute;left:-8px;top:0;bottom:0;width:1px;background:var(--line)}\n.recommendation .total-label{font-size:11.9px;color:var(--muted);min-width:0;overflow-wrap:anywhere}\n.recommendation .club-summary .number{font-size:17px;font-weight:400;line-height:1.5;margin-top:5px;text-align:left;overflow-wrap:anywhere}\n.recommendation .number small{font-size:12.75px;font-weight:400}\n.recommendation .summary-cost{font-size:10.2px;font-weight:400;color:var(--muted);margin-top:8px;text-align:left;overflow-wrap:anywhere}\n.consumption-total{display:flex;justify-content:flex-end;align-items:baseline;flex-wrap:wrap;gap:8px;margin-top:12px;font-size:11.9px;font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}\n#calculateAll{font-size:9.8px;padding:7.7px 11.2px;border-radius:6.3px}\n@media(max-width:599px){\n .suggestions-grid,.recommendation{grid-template-columns:minmax(0,1fr);row-gap:24px}\n .suggestions-grid::before,.recommendation::after{display:none}\n .suggestions-grid>div{justify-self:start;width:100%}\n}\n@media(min-width:600px) and (max-width:1000px){\n .total-grid{--sonuc-aralik:24px}\n .club-summaries{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:16px}\n .club-summary:nth-child(3)::before{display:none}\n .suggestions-grid>div{grid-template-columns:minmax(0,1fr) 90px;column-gap:6px}\n .offer-content{justify-self:start;width:100%}\n}\n@media(max-width:500px){\n .need-summary>.total-label{font-size:12px;white-space:normal;width:100%;min-width:0}\n .need-summary>.number{font-size:32px}\n .suggestions-grid .number{font-size:25.6px}\n .club-summaries{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:16px}\n .club-summary:nth-child(3)::before{display:none}\n}\n.reset-actions{display:flex;justify-content:flex-end;margin-top:24px;margin-bottom:10px}.reset-actions+.total{margin-top:0}\n</style></head><body>\n\n<main>\n<div class=\"eyebrow\">GÖNDERİ VE TOKEN PLANLAMASI</div>\n<h1>Token İhtiyacı Simülatörü</h1>\n<p class=\"intro\">Her modül için <strong style=\"color:var(--blue)\">aylık</strong> gönderim planınızı girin. Açık kartların tüketimini toplayarak token ihtiyacınızı görün.</p>\n<form id=\"scenario\" novalidate>\n<fieldset id=\"cevaplar\" disabled style=\"border:0;padding:0;margin:0;min-width:0\"><div class=\"results\">\n<section class=\"card module\" id=\"card-t\" aria-labelledby=\"title-t\">\n<div class=\"heading\"><h2 id=\"title-t\">T-Club · Temsilcilere özel</h2><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"on-t\" checked aria-label=\"T-Club tüketimini toplama dahil et\"><span id=\"switch-t\">Açık</span></label></div>\n<div class=\"module-inputs\">\n<div class=\"fields\">\n<label class=\"field\"><span>T1 · Saha ekibinizde kaç temsilci var?</span><div class=\"input\"><input id=\"tAudience\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>kişi</small></div></label>\n<label class=\"field\"><span>T2 · Saha ekibine bir ayda merkezden kaç yayın gönderebilirsiniz?</span><div class=\"input\"><input id=\"tPublications\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>yayın</small></div></label>\n\n<label class=\"field\"><span>T3 · Bölge müdürleriniz bir ayda kaç temsilciye öneri gönderebilir?</span><div class=\"input\"><input id=\"tRecommendationAudience\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>kişi</small></div></label>\n<label class=\"field\"><span>T4 · Bir Bölge Müdürü, bir ayda bir temsiciye kaç öneride bulunabilir?</span><div class=\"input\"><input id=\"tRecommendations\" type=\"number\" min=\"0\" max=\"12\" step=\"1\" value=\"\" required><small>öneri</small></div></label>\n</div>\n</div>\n<div class=\"module-output\" aria-live=\"polite\" aria-atomic=\"true\"><p class=\"state error\" id=\"error-t\" role=\"alert\" hidden></p><div class=\"module-total\"><span style=\"font-weight:700\">Gelişim için ihtiyaç olan toplam token</span><strong><span id=\"value-t\">—</span> <small style=\"font-weight:700\">token</small></strong></div><p class=\"subnote\">(T1 × T2) + (T3 × T4)</p></div>\n\n</section>\n<section class=\"card module\" id=\"card-c\" aria-labelledby=\"title-c\">\n<div class=\"heading\"><h2 id=\"title-c\">C-Club · Bölge Müdürlerine özel</h2><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"on-c\" checked aria-label=\"C-Club tüketimini toplama dahil et\"><span id=\"switch-c\">Açık</span></label></div>\n<div class=\"module-inputs\"><div class=\"fields\">\n<label class=\"field\"><span>C1 · Ekibinizde kaç Bölge Müdürü görev alıyor?</span><div class=\"input\"><input id=\"cAudience\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>kişi</small></div></label>\n<label class=\"field\"><span>C2 · Bölge Müdürlerinize bir ayda merkezden kaç yayın gönderebilirsiniz?</span><div class=\"input\"><input id=\"cPublications\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>yayın</small></div></label>\n<label class=\"field\"><span>C3 · Bir Bölge Müdürü ayda kaç challenge gönderebilir?</span><div class=\"input\"><input id=\"cChallenges\" type=\"number\" min=\"0\" max=\"3\" step=\"1\" value=\"\" required><small>gönderi</small></div></label>\n</div></div>\n<div class=\"module-output\" aria-live=\"polite\" aria-atomic=\"true\"><p class=\"state error\" id=\"error-c\" role=\"alert\" hidden></p><div class=\"module-total\"><span>Değişim için ihtiyaç olan toplam token</span><strong><span id=\"value-c\">—</span> <small>token</small></strong></div><p class=\"subnote\">(C1 × C2) + (C1 × C3)</p></div>\n\n</section>\n<section class=\"card module\" id=\"card-e\" aria-labelledby=\"title-e\">\n<div class=\"heading\"><h2 id=\"title-e\">E-Club · Eczanelere özel</h2><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"on-e\" aria-label=\"E-Club tüketimini toplama dahil et\" checked><span id=\"switch-e\">Açık</span></label></div>\n<div class=\"module-inputs\"><div class=\"fields\">\n<label class=\"field\"><span>E1 · Saha ekibinin kaverajında olan toplam eczane sayısı ne kadar?</span><div class=\"input\"><input id=\"ePharmacies\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>eczane</small></div></label>\n<label class=\"field\"><span>E2 · Eczane başına, ortalama eczane çalışanı sayısını kaç kişi öngörüyorsunuz?</span><div class=\"input\"><input id=\"eEmployees\" type=\"number\" min=\"0\" max=\"1000\" step=\"any\" value=\"\" required><small>kişi</small></div></label>\n<label class=\"field\"><span>E3 · Eczane çalışanlarının kaçının E-Club üyesi olabileceğini öngörüyorsunuz?</span><div class=\"input\"><input id=\"eMembership\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"\" required><small>%</small></div></label>\n<label class=\"field\"><span>E4 · Saha ekibiniz aracılığıyla bir E-Club üyesine ayda kaç yayın gönderebilirsiniz?</span><div class=\"input\"><input id=\"eSends\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>gönderi</small></div></label>\n</div></div>\n<div class=\"module-output\" aria-live=\"polite\" aria-atomic=\"true\"><p class=\"state error\" id=\"error-e\" role=\"alert\" hidden></p><div class=\"module-total\"><span>Rekabet için ihtiyaç olan toplam token</span><strong><span id=\"value-e\">—</span> <small>token</small></strong></div><p class=\"subnote\">E1 × E2 × (E3 / 100) × E4</p></div>\n\n</section>\n<section class=\"card module\" id=\"card-m\" aria-labelledby=\"title-m\">\n<div class=\"heading\"><h2 id=\"title-m\">Eczanem · Danışanlara özel</h2><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"on-m\" checked aria-label=\"Eczanem tüketimini toplama dahil et\"><span id=\"switch-m\">Açık</span></label></div>\n<div class=\"module-inputs\"><div class=\"fields\">\n<label class=\"field\"><span>D1 · Kaç E-Club eczanesi Eczanem uygulamasına geçiş yapabilir?</span><div class=\"input\"><input id=\"mTransition\" type=\"number\" min=\"0\" max=\"100\" step=\"any\" value=\"\" required><small>%</small></div></label>\n<label class=\"field\"><span>D2 · Eczane başına ortalama danışan sayısını kaç öngörüyorsunuz?</span><div class=\"input\"><input id=\"mRecipients\" type=\"number\" min=\"10\" max=\"1000000\" step=\"any\" value=\"\" required><small>kişi</small></div></label>\n<label class=\"field\"><span>D3 · Eczaneler aracılığıyla bir ayda danışanlara özel kaç yayın gönderebilirsiniz?</span><div class=\"input\"><input id=\"mSends\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"\" required><small>yayın</small></div></label>\n</div></div>\n<div class=\"module-output\" aria-live=\"polite\" aria-atomic=\"true\"><p class=\"state error\" id=\"error-m\" role=\"alert\" hidden></p><div class=\"module-total\"><span>Marka bağlılığı için ihtiyaç olan token</span><strong><span id=\"value-m\">—</span> <small>token</small></strong></div><p class=\"subnote\">E1 × (E3 / 100) × (D1 / 100) × D2 × D3</p></div>\n\n</section>\n</div>\n</fieldset></form>\n<div class=\"reset-actions\"><button type=\"button\" class=\"primary\" id=\"calculateAll\" disabled>Hepsini sil</button></div>\n<section class=\"card total\" aria-live=\"polite\" aria-atomic=\"true\"><div class=\"total-grid\"><div class=\"need-summary\"><div class=\"total-label\">İhtiyacınız Olan Token Sayısı</div><div class=\"number\"><span id=\"monthlyTokens\">—</span></div></div><div class=\"purchase-summary\"><div class=\"suggestions-grid\"><div><div class=\"offer-content\"><div class=\"total-label\">Önerilen Esnek Paket</div><div class=\"number\"><span id=\"recommendedTokens\">—</span> <small>token</small></div><div class=\"package-pricing\"><span class=\"package-price\" id=\"recommendedPackage\"></span><span class=\"price-separator\" aria-hidden=\"true\"> · </span><span class=\"package-terms\" id=\"recommendedTerms\"></span></div></div><button type=\"button\" class=\"pricing-link\" id=\"flexiblePricesLink\">Esnek Paket <svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></div><div><div class=\"offer-content\"><div class=\"total-label\">Önerilen Abonelik Paketi</div><div class=\"number\"><span id=\"subscriptionTokens\">—</span> <small>token / ay</small></div><div class=\"package-pricing\"><span class=\"package-price\" id=\"subscriptionPackage\"></span><span class=\"price-separator\" aria-hidden=\"true\"> · </span><span class=\"package-terms\" id=\"subscriptionTerms\"></span></div></div><button type=\"button\" class=\"pricing-link\" id=\"subscriptionPricesLink\">Abonelik Paketleri <svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></div></div></div><div class=\"recommendation\"><div class=\"summary-column\"><div class=\"club-summaries\"><div class=\"club-summary\"><div class=\"total-label\">Öğrenmek için</div><div class=\"number\"><span id=\"summaryTtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"summaryTcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Değişim için</div><div class=\"number\"><span id=\"summaryCtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"summaryCcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Rekabet için</div><div class=\"number\"><span id=\"summaryEtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"summaryEcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Marka için</div><div class=\"number\"><span id=\"summaryMtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"summaryMcost\">—</p></div></div><div class=\"consumption-total\"><span>Toplam</span><span id=\"flexibleConsumptionTotal\">—</span></div></div><div class=\"summary-column\"><div class=\"club-summaries\"><div class=\"club-summary\"><div class=\"total-label\">Öğrenmek için</div><div class=\"number\"><span id=\"subscriptionSummaryTtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"subscriptionSummaryTcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Değişim için</div><div class=\"number\"><span id=\"subscriptionSummaryCtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"subscriptionSummaryCcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Rekabet için</div><div class=\"number\"><span id=\"subscriptionSummaryEtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"subscriptionSummaryEcost\">—</p></div><div class=\"club-summary\"><div class=\"total-label\">Marka için</div><div class=\"number\"><span id=\"subscriptionSummaryMtokens\">—</span> <small>token</small></div><p class=\"summary-cost\" id=\"subscriptionSummaryMcost\">—</p></div></div><div class=\"consumption-total\"><span>Toplam</span><span id=\"subscriptionConsumptionTotal\">—</span></div></div></div></div><p class=\"total-note\" id=\"totalNote\"></p></section>\n\n\n</main>\n<script>\n(function(){'use strict';\nconst el=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('tr-TR',{maximumFractionDigits:2}).format(n);\nconst inputIds=[\"tAudience\", \"tPublications\", \"tRecommendationAudience\", \"tRecommendations\", \"cAudience\", \"cPublications\", \"cChallenges\", \"ePharmacies\", \"eEmployees\", \"eMembership\", \"eSends\", \"mTransition\", \"mRecipients\", \"mSends\"];\nconst dependencies={t:['tAudience','tPublications','tRecommendationAudience','tRecommendations'],c:['cAudience','cPublications','cChallenges'],e:['ePharmacies','eEmployees','eMembership','eSends'],m:['ePharmacies','eMembership','mTransition','mRecipients','mSends']};\nconst names={t:'T-Club',c:'C-Club',e:'E-Club',m:'Eczanem'},keys=Object.keys(names),cache={};\nconst text=(id,s)=>{el(id).textContent=s;};\nfunction valid(id){if(el(id).value===''&&!el(id).validity.badInput){el(id).removeAttribute('aria-invalid');return true;}const ok=el(id).checkValidity();el(id).setAttribute('aria-invalid',String(!ok));return ok;}\nfunction limit(){const raw=el('cAudience').value,n=Number(raw),ok=raw!==''&&Number.isInteger(n)&&n>=0;const cap=ok?Math.min(3,Math.max(0,n-1)):0;el('cChallenges').max=String(cap);}\nfunction state(k){const active=el('on-'+k).checked;el('card-'+k).dataset.active=String(active);text('switch-'+k,active?'Açık':'Kapalı');}\nfunction row(label,value){const r=document.createElement('div');r.className='row';const a=document.createElement('span'),b=document.createElement('strong');a.textContent=label;b.textContent=value;r.append(a,b);return r;}\nfunction calculate(k){\n if(k==='c')limit();\n const checks=dependencies[k].map(valid);\n if(checks.includes(false)){\n  let error='Bu karttaki işaretli girdileri kontrol edin.';\n  if(k==='m'&&el('mRecipients').value!==''&&Number(el('mRecipients').value)<10)error='Eczane başına ortalama danışan sayısı en az 10 olmalıdır.';\n  if(k==='t'&&!el('tRecommendations').checkValidity())error='UTT başına aylık öneri sayısı 0–12 arasında tam sayı olmalıdır.';\n  if(k==='c'&&!el('cChallenges').checkValidity())error='Gönderi sayısı alıcı sayısından fazla olamaz. Bir BM ayda en fazla 3 challenge gönderebilir. Aynı BM’ye aynı ay yalnızca 1 kez gönderebilir.';\n  cache[k]={error};paint(k);return;\n }\n if(dependencies[k].some(id=>el(id).value==='')){cache[k]={pending:true};paint(k);return;}\n const v=Object.fromEntries(dependencies[k].map(id=>[id,Number(el(id).value)]));\n let amount,rows;\n if(k==='t'){amount=v.tAudience*v.tPublications+v.tRecommendationAudience*v.tRecommendations;}\n if(k==='c'){amount=v.cAudience*v.cPublications+v.cAudience*v.cChallenges;}\n if(k==='e'){const employees=v.ePharmacies*v.eEmployees,members=employees*v.eMembership/100;amount=members*v.eSends;rows=[['Eczanelerdeki toplam çalışan',fmt(employees)+' kişi'],['Hesaplanan E-Club üyesi',fmt(members)+' kişi'],['UTT → Üye gönderimi',fmt(members)+' × '+fmt(v.eSends)+' = '+fmt(amount)]];}\n if(k==='m'){const pharmacies=v.ePharmacies*(v.eMembership/100)*(v.mTransition/100);amount=pharmacies*v.mRecipients*v.mSends;}\n cache[k]={amount,rows};paint(k);\n}\nfunction paint(k){text('value-'+k,cache[k]&&!cache[k].error&&!cache[k].pending?fmt(cache[k].amount):'—');text('error-'+k,cache[k]?.error||'');el('error-'+k).hidden=!cache[k]?.error;state(k);}\n// Güncel fiyatlar üst sayfanın yetkili fiyat API'sinden gelir; eski sabit fiyat kullanılmaz.\nlet pricing=null,pricingError='';\nconst money=cents=>new Intl.NumberFormat('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2}).format(cents/100)+' TL';\nfunction recommend(need){\n text('recommendedTokens','—');text('recommendedPackage','');text('recommendedTerms','');\n text('subscriptionTokens','—');text('subscriptionPackage','');text('subscriptionTerms','');\n text('flexibleConsumptionTotal','—');text('subscriptionConsumptionTotal','—');\n const tAmount=el('on-t').checked?(cache.t&&!cache.t.error&&!cache.t.pending?cache.t.amount:null):0;\n text('summaryTtokens',tAmount===null?'—':fmt(tAmount));text('summaryTcost','—');\n const cAmount=el('on-c').checked?(cache.c&&!cache.c.error&&!cache.c.pending?cache.c.amount:null):0;\n text('summaryCtokens',cAmount===null?'—':fmt(cAmount));text('summaryCcost','—');\n const eAmount=el('on-e').checked?(cache.e&&!cache.e.error&&!cache.e.pending?cache.e.amount:null):0;\n text('summaryEtokens',eAmount===null?'—':fmt(eAmount));text('summaryEcost','—');\n const mAmount=el('on-m').checked?(cache.m&&!cache.m.error&&!cache.m.pending?cache.m.amount:null):0;\n text('summaryMtokens',mAmount===null?'—':fmt(mAmount));text('summaryMcost','—');\n const amounts={T:tAmount,C:cAmount,E:eAmount,M:mAmount};\n Object.entries(amounts).forEach(([key,value])=>{text('subscriptionSummary'+key+'tokens',value===null?'—':fmt(value));text('subscriptionSummary'+key+'cost','—');});\n if(need==null)return;\n if(need===0){text('flexibleConsumptionTotal',money(0));text('subscriptionConsumptionTotal',money(0));text('recommendedTokens','0');text('subscriptionTokens','0');text('summaryTcost',money(0));text('summaryCcost',money(0));text('summaryEcost',money(0));text('summaryMcost',money(0));Object.keys(amounts).forEach(key=>text('subscriptionSummary'+key+'cost',money(0)));return;}\n if(!pricing){text('recommendedTerms',pricingError||'Güncel fiyatlar yükleniyor…');text('subscriptionTerms',pricingError||'Güncel fiyatlar yükleniyor…');return;}\n const flexible=pricing.sm2.filter(h=>h.ay===0&&h.token_adedi>=need).map(h=>{\n  const unitCents=Math.round(h.birim_fiyat*100);\n  return {quantity:h.token_adedi,unitCents,cents:h.token_adedi*unitCents};\n }).sort((a,b)=>a.quantity-b.quantity||a.cents-b.cents)[0];\n const subscription=pricing.paketler.filter(p=>p.token>=need).map(p=>({quantity:p.token,unitCents:Math.round(p.birim*100),cents:Math.round(p.aylik*100)})).sort((a,b)=>a.quantity-b.quantity||a.cents-b.cents)[0];\n function offer(prefix,value){\n  if(!value){text(prefix+'Terms','Bu ihtiyacı karşılayan paket bulunmuyor.');return;}\n  text(prefix+'Tokens',fmt(value.quantity));text(prefix+'Package',money(value.cents));text(prefix+'Terms',money(value.unitCents)+' / token');\n }\n offer('recommended',flexible);offer('subscription',subscription);\n // Her tablonun tutarı kendi önerisinin birim fiyatıyla hesaplanır.\n for(const [prefix,offer] of [['summary',flexible],['subscriptionSummary',subscription]]){\n  if(!offer)continue;\n  let totalCents=0;\n  Object.entries(amounts).forEach(([key,value])=>{if(value!==null){const cents=Math.round(value*offer.unitCents);totalCents+=cents;text(prefix+key+'cost',money(cents));}});\n  text(prefix==='summary'?'flexibleConsumptionTotal':'subscriptionConsumptionTotal',money(totalCents));\n }\n}\nfunction total(){const active=keys.filter(k=>el('on-'+k).checked),pending=active.filter(k=>!cache[k]||cache[k].error||cache[k].pending);\n if(pending.length){recommend(null);text('monthlyTokens','—');text('totalNote','');return;}\n const sum=active.reduce((n,k)=>n+cache[k].amount,0);recommend(Math.ceil(sum));text('monthlyTokens',fmt(Math.ceil(sum)));text('totalNote','');\n}\nfunction all(){keys.forEach(calculate);total();}\ninputIds.forEach(id=>el(id).addEventListener('input',()=>{if(id==='cAudience')limit();keys.filter(k=>dependencies[k].includes(id)).forEach(calculate);total();}));\nkeys.forEach(k=>{el('on-'+k).addEventListener('change',()=>{if(el('on-'+k).checked)calculate(k);state(k);total();});});\nel('calculateAll').addEventListener('click',()=>{inputIds.forEach(id=>{el(id).value='';el(id).removeAttribute('aria-invalid');});keys.forEach(k=>{el('on-'+k).checked=el('on-'+k).defaultChecked;delete cache[k];text('value-'+k,'—');text('error-'+k,'');el('error-'+k).hidden=true;state(k);});limit();total();});el('scenario').addEventListener('submit',e=>e.preventDefault());all();\n\n// Sayfa yenilendiğinde girilen planı geri yükle; çerçevede saklamayı üst sayfa yapar.\nconst embedded=window.parent!==window;\nlet storageReady=!embedded;\nconst draftKey='cogniti:planlama:taslak:v1';\nfunction snapshot(){return {version:1,values:Object.fromEntries(inputIds.map(id=>[id,el(id).value])),switches:Object.fromEntries(keys.map(k=>[k,el('on-'+k).checked]))};}\nfunction restore(draft){\n if(storageReady&&embedded){window.parent.postMessage({type:\"cogniti-planlama-yuklendi\"},\"*\");return;}\n if(draft&&draft.version===1){\n  inputIds.forEach(id=>{const value=draft.values?.[id];if(typeof value==='string'&&value.length<=30)el(id).value=value;});\n  keys.forEach(k=>{const active=draft.switches?.[k];if(typeof active==='boolean')el('on-'+k).checked=active;});\n  all();\n }\n storageReady=true;\n el('cevaplar').disabled=false;\n el('calculateAll').disabled=false;\n if(embedded)window.parent.postMessage({type:'cogniti-planlama-yuklendi'},'*');\n}\nfunction saveDraft(){\n if(!storageReady)return;\n const draft=snapshot();\n if(embedded)window.parent.postMessage({type:'cogniti-planlama-kaydet',draft},'*');\n else try{localStorage.setItem(draftKey,JSON.stringify(draft));}catch{}\n}\nif(embedded){\n window.addEventListener('message',event=>{\n  if(event.source!==window.parent)return;\n  if(event.data?.type==='cogniti-planlama-yukle')restore(event.data.draft);\n  if(event.data?.type==='cogniti-planlama-tarife'){pricing=event.data.tarife;pricingError=event.data.hata||'';total();}\n  if(event.data?.type==='cogniti-planlama-hazir-misin')window.parent.postMessage({type:'cogniti-planlama-hazir'},'*');\n });\n window.parent.postMessage({type:'cogniti-planlama-hazir'},'*');\n}else{\n try{restore(JSON.parse(localStorage.getItem(draftKey)||'null'));}catch{restore(null);}\n}\n['flexiblePricesLink','subscriptionPricesLink'].forEach(id=>el(id).addEventListener('click',()=>{if(embedded)window.parent.postMessage({type:'cogniti-planlama-fiyatlara-git'},'*');else window.location.href='/fiyatlar';}));\nel('scenario').addEventListener('input',saveDraft);\nel('scenario').addEventListener('change',saveDraft);\nel('calculateAll').addEventListener('click',saveDraft);\n\n})();\n</script><script>(()=>{const report=()=>{const main=document.querySelector('main');if(main)parent.postMessage({type:'cogniti-planlama-yukseklik',height:Math.ceil(main.getBoundingClientRect().bottom+window.scrollY)},'*');};new ResizeObserver(report).observe(document.body);document.fonts.ready.then(report);window.addEventListener('load',report);report();})();</script></body></html>\n"
